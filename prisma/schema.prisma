generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  OFF_ROAD
  ON_ROAD
  EXHIBITION
  CHARITABLE
}

enum EventDifficulty {
  EASY
  MODERATE
  MEDIUM
  HARD
  VERY_HARD
}

enum EventState {
  SCHEDULED
  IN_PROGRESS
  CANCELLED
  FINISHED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  READY_FOR_EDIT
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model Event {
  id            String              @id @default(uuid())
  ownerId       String
  name          String
  description   String
  city          String
  startDate     DateTime
  endDate       DateTime?
  difficulty    EventDifficulty
  meetingPoint  String
  destination   String
  meetingTime   DateTime
  eventType     EventType
  allowedBrands String[]
  price         Float?
  imageUrl      String?
  state         EventState
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt()
  registrations EventRegistration[]
}

model EventRegistration {
  id                    String             @id @default(uuid())
  eventId               String
  userId                String
  status                RegistrationStatus @default(PENDING)
  fullName              String
  identificationNumber  String
  birthDate             DateTime
  phone                 String
  email                 String
  residenceCity         String
  eps                   String
  medicalInsurance      String?
  bloodType             BloodType
  emergencyContactName  String
  emergencyContactPhone String
  vehicleId             String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt()

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
}
