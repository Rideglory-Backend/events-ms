generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  offRoad
  onRoad
  exhibition
  charitable
}

enum EventDifficulty {
  one
  two
  three
  four
  five
}

enum EventState {
  scheduled
  inProgress
  cancelled
  finished
}

model Event {
  id            String          @id @default(uuid())
  ownerId       String
  name          String
  description   String
  city          String
  startDate     DateTime
  endDate       DateTime?
  difficulty    EventDifficulty
  meetingPoint  String
  destination   String
  meetingTime   DateTime
  eventType     EventType
  allowedBrands String[]
  price         Float?
  imageUrl      String?
  state         EventState
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt()
}
