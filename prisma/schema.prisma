generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  OFF_ROAD
  ON_ROAD
  EXHIBITION
  CHARITABLE
}

enum EventDifficulty {
  EASY
  MODERATE
  MEDIUM
  HARD
  VERY_HARD
}

enum EventState {
  SCHEDULED
  IN_PROGRESS
  CANCELLED
  FINISHED
}

model Event {
  id            String          @id @default(uuid())
  ownerId       String
  name          String
  description   String
  city          String
  startDate     DateTime
  endDate       DateTime?
  difficulty    EventDifficulty
  meetingPoint  String
  destination   String
  meetingTime   DateTime
  eventType     EventType
  allowedBrands String[]
  price         Float?
  imageUrl      String?
  state         EventState
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt()
}
